{
    "name": "glide-data-grid-ember",
    "version": "0.1.4",
    "description": "A fast, canvas-rendered data grid for Ember — an Ember v2 addon port of glide-data-grid.",
    "keywords": [
        "ember-addon",
        "data-grid",
        "datagrid",
        "table",
        "canvas",
        "glide-data-grid",
        "virtualized"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ultish/glide-data-grid-ember.git"
    },
    "license": "MIT",
    "author": "",
    "exports": {
        ".": {
            "types": "./declarations/index.d.ts",
            "default": "./dist/index.js"
        },
        "./*": {
            "types": "./declarations/*.d.ts",
            "default": "./dist/*.js"
        },
        "./addon-main.js": "./addon-main.cjs"
    },
    "typesVersions": {
        "*": {
            "*": [
                "declarations/*"
            ]
        }
    },
    "files": [
        "addon-main.cjs",
        "CHANGELOG.md",
        "declarations",
        "dist"
    ],
    "scripts": {
        "build": "rollup --config",
        "format": "prettier . --cache --write",
        "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
        "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm run format",
        "lint:format": "prettier . --cache --check",
        "lint:hbs": "ember-template-lint . --no-error-on-unmatched-pattern",
        "lint:hbs:fix": "ember-template-lint . --fix --no-error-on-unmatched-pattern",
        "lint:js": "eslint . --cache",
        "lint:js:fix": "eslint . --fix",
        "lint:types": "ember-tsc --noEmit",
        "prepack": "rollup --config",
        "start": "rollup --config --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint:types:test": "ember-tsc --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "@embroider/addon-shim": "^1.8.9",
        "@glimmer/component": "^2.1.1",
        "canvas-hypertxt": "^1.0.3",
        "decorator-transforms": "^2.2.2",
        "ember-modifier": "^4.3.0",
        "lodash": "^4.17.19",
        "marked": "^16.1.2"
    },
    "devDependencies": {
        "@babel/core": "^7.25.2",
        "@babel/eslint-parser": "^7.25.1",
        "@babel/plugin-transform-typescript": "^7.25.2",
        "@babel/runtime": "^7.25.6",
        "@ember/library-tsconfig": "^1.1.3",
        "@embroider/addon-dev": "^8.3.1",
        "@eslint/js": "^9.17.0",
        "@glimmer/validator": "^0.92.3",
        "@glint/ember-tsc": "^1.10.0",
        "@glint/template": "^1.8.0",
        "@rollup/plugin-babel": "^6.0.4",
        "@types/lodash": "^4.17.17",
        "babel-plugin-ember-template-compilation": "^3.1.0",
        "concurrently": "^9.0.1",
        "ember-source": "~6.12.0",
        "ember-template-lint": "^6.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-ember": "^12.3.3",
        "eslint-plugin-import": "^2.31.0",
        "eslint-plugin-n": "^17.15.1",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
        "prettier-plugin-ember-template-tag": "^2.0.4",
        "rollup": "^4.22.5",
        "rollup-plugin-copy": "^3.5.0",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.19.1",
        "vitest": "^4.1.10"
    },
    "ember": {
        "edition": "octane"
    },
    "ember-addon": {
        "version": 2,
        "type": "addon",
        "main": "addon-main.cjs",
        "app-js": {
            "./components/glide-data-grid.js": "./dist/_app_/components/glide-data-grid.js",
            "./components/glide-search-bar.js": "./dist/_app_/components/glide-search-bar.js"
        }
    }
}

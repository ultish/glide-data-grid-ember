{
  "extends": "@ember/app-tsconfig",
  "include": [
    "app", "tests", "types"
  ],
  /* Glint v2 needs no `"glint": { "environment": [...] }` block -- environments were a v1 concept
     and the key is removed as part of the v2 upgrade. This app has no `.hbs` files, only `.gts`,
     so v2 dropping the Ember Loose environment costs it nothing. */
  "compilerOptions": {
    "allowJs": true,
    /**
      https://www.typescriptlang.org/tsconfig#noEmitOnError
      Do not block emit on TS errors.
    */
    "noEmitOnError": false,

    "declaration": false,
    "declarationMap": false,

    /**
      https://www.typescriptlang.org/tsconfig#allowImportingTsExtensions

      We want our tooling to know how to resolve our custom files so the appropriate plugins
      can do the proper transformations on those files.
    */
    "allowImportingTsExtensions": true,
    "paths": {
      "test-app/tests/*": [
        "./tests/*"
      ],
      "test-app/*": [
        "./app/*"
      ],
      "*": [
        "./types/*"
      ]
    },
    "types": [
      "ember-source/types"
    ]
  },
}

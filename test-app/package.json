{
    "name": "test-app",
    "version": "0.0.0",
    "private": true,
    "description": "Small description for test-app goes here",
    "repository": "",
    "license": "MIT",
    "author": "",
    "directories": {
        "doc": "doc",
        "test": "tests"
    },
    "scripts": {
        "build": "vite build",
        "format": "prettier . --cache --write",
        "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
        "lint:css": "stylelint \"**/*.css\"",
        "lint:css:fix": "concurrently \"pnpm:lint:css -- --fix\"",
        "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
        "lint:format": "prettier . --cache --check",
        "lint:hbs": "ember-template-lint .",
        "lint:hbs:fix": "ember-template-lint . --fix",
        "lint:js": "eslint . --cache",
        "lint:js:fix": "eslint . --fix",
        "lint:types": "ember-tsc --noEmit",
        "start": "vite",
        "test": "concurrently \"pnpm:lint\" \"pnpm:test:*\" --names \"lint,test:\" --prefixColors auto",
        "test:ember": "vite build --mode test && ember test --path dist"
    },
    "dependencies": {
        "glide-data-grid-ember": "workspace:*",
        "object-scan": "^20.0.4"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/eslint-parser": "^7.28.6",
        "@babel/plugin-transform-runtime": "^7.25.9",
        "@babel/plugin-transform-typescript": "^7.25.2",
        "@babel/runtime": "^7.0.0",
        "@ember-data/adapter": "~5.8.1",
        "@ember-data/graph": "~5.8.1",
        "@ember-data/json-api": "~5.8.1",
        "@ember-data/legacy-compat": "~5.8.1",
        "@ember-data/model": "~5.8.1",
        "@ember-data/request": "~5.8.1",
        "@ember-data/request-utils": "~5.8.1",
        "@ember-data/serializer": "~5.8.1",
        "@ember-data/store": "~5.8.1",
        "@ember/app-tsconfig": "^2.0.0",
        "@ember/optional-features": "^2.3.0",
        "@ember/string": "^4.0.0",
        "@ember/test-helpers": "^4.0.5",
        "@embroider/compat": "^4.0.0-alpha.0",
        "@embroider/config-meta-loader": "^1.0.0-alpha.0",
        "@embroider/core": "^4.0.0-alpha.0",

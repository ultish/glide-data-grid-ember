        "typescript-eslint": "^8.58.1",
        "vite": "^6.0.0"
    },
    "engines": {
        "node": ">= 20.19"
    },
    "ember": {
        "edition": "octane"
    },
    "ember-addon": {
        "type": "app",
        "version": 2
    },
    "exports": {
        "./tests/*": "./tests/*",
        "./*": "./app/*"
    }
